# SERVER
PORT=5000
NODE_ENV=development

# ─── MONGODB ────────────────────────────────
# ⚠️  CHANGE: Atlas use karo ya local MongoDB
# Local:  mongodb://localhost:27017/medicart
# Atlas:  mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/medicart
MONGO_URI=mongodb://medicart123:medicart0068@ac-eff4n1g-shard-00-00.wxmijuh.mongodb.net:27017,ac-eff4n1g-shard-00-01.wxmijuh.mongodb.net:27017,ac-eff4n1g-shard-00-02.wxmijuh.mongodb.net:27017/?ssl=true&replicaSet=atlas-5qp8c5-shard-0&authSource=admin&appName=medicart

# ─── JWT ────────────────────────────────────
# ✅ Already generated — kuch change mat karo
JWT_SECRET=42a432da16970fe6782e18c9800a17c6b66485dc04738dbdee6382231b5030b4
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=93d95ca8752154a23e267a02261e0080c8760031299fbef50caff852a3b2d444
