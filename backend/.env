# ─── CLOUDINARY ─────────────────────────────
# ⚠️  CHANGE: cloudinary.com → Dashboard → Settings → API Keys
# Agar khali chhodo to images locally uploads/ folder mein jayengi
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── RAZORPAY ───────────────────────────────
# ⚠️  CHANGE: razorpay.com → Dashboard → Settings → API Keys
# Test keys: rzp_test_... se shuru hongi
RAZORPAY_KEY_ID=rzp_test_SZW8NuxbdjMX6o
RAZORPAY_KEY_SECRET=hdKeqRXc7TKxz5Ki5WrhC09A

# ─── EMAIL (Gmail) ──────────────────────────
# ⚠️  CHANGE: Apni Gmail ID aur App Password dalo
# App Password kaise banaye:
# Google Account → Security → 2-Step Verification ON karo
# Phir: Security → App Passwords → "Mail" select karo → Generate
SMTP_HOST=
SMTP_PORT=
SMTP_EMAIL=
SMTP_PASSWORD=
FROM_NAME=
FROM_EMAIL=

# ─── FRONTEND URL (CORS) ────────────────────
# ✅ Agar Vite default use kar rahe ho to change mat karo
# Production pe apna domain daalna: https://medicart.in
CLIENT_URL=http://localhost:5174

# ─── UNICARE INTEGRATION ────────────────────
